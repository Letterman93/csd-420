<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<!-- VBox stacks the controls vertically. fx:controller connects the layout to Java. -->
<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ExampleController">

    <!-- fx:id matches the messageLabel field in ExampleController. -->
    <Label fx:id="messageLabel"
           text="Click the button below." />

    <!-- The # identifies the controller method to call when the button is clicked. -->
    <Button text="Click Me"
            onAction="#handleButtonClick" />

</VBox>
